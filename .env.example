# Copy this file to .env and fill in real values. .env is ignored by git.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=medai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only user for the agent's SQL tool (Day 4)
AGENT_DB_USER=agent_readonly
AGENT_DB_PASSWORD=change-me-too

# --- Embeddings ---
# Local multilingual model (free, supports Hebrew). Dimension must match the model.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- LLM (Day 3) ---
# LLM_PROVIDER=openai   or   anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic) / gpt-4o-mini (openai)
LLM_MODEL=
